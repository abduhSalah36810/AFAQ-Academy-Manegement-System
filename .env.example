# AFAQ Academy — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Required ─────────────────────────────────────────────────────────────────

# Cryptographic signing key for session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-hex-value

# Application environment: development | production
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────

# Local SQLite (default — do not use this in production):
# DATABASE_URL=sqlite:///./afaq.db

# Production PostgreSQL (Supabase, Railway, Neon, etc.):
# DATABASE_URL=postgresql://user:password@host:port/dbname

DATABASE_URL=sqlite:///./afaq.db

# ── Optional ──────────────────────────────────────────────────────────────────

# Set to true to display detailed error pages (development only)
DEBUG=false

# CORS allowed origins (comma-separated) — for future API use
# ALLOWED_ORIGINS=https://yourdomain.com
